# --- Authentication ---------------------------------------------------------
# Key used by the signing / withdrawal service
SENTINEL_API_KEY=change-me-long-random-string
# Operators for the console and manual approvals: name:key,name:key
SENTINEL_OPERATOR_KEYS=alice:change-me-alice,bob:change-me-bob

# --- Attestation (generate with: sentinel keygen) ---------------------------
SENTINEL_SIGNING_KEY=

# --- Storage ------------------------------------------------------------------
# Leave empty for single-node in-memory state
SENTINEL_REDIS_URL=
SENTINEL_AUDIT_DB=data/audit.db
# SENTINEL_POLICY=config/policy.yaml

# --- On-chain data -------------------------------------------------------------
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BITCOIN_API_URL=https://mempool.space/api

# --- Alerts --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Misc ----------------------------------------------------------------------
# true = every address looks new, no external calls. NEVER in production.
SENTINEL_DEV_MODE=false
SENTINEL_LOG_LEVEL=INFO
